# WUG authentication: use either user/password or session cookie.
WUG_USER=
WUG_PASS=
WUG_COOKIE=

# Optional notification channels.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TEAMS_WEBHOOK_URL=

# Runtime behavior.
ALERT_AFTER_MIN=10
# Escalamiento: segundo aviso si la caida sigue activa tras N min (0 = desactivado).
# ESCALATION_CONTACT es quien debe dar seguimiento (se muestra en el mensaje).
ESCALATION_AFTER_MIN=60
ESCALATION_CONTACT=
# Al arrancar sin estado, alerta las caidas en curso de las ultimas N horas.
BASELINE_MAX_AGE_HOURS=24
# Plan de autonomia: aviso de entrada y de hora limite (caida + autonomia - movilizacion).
# PLAN_ENTRADA_AFTER_MIN: minutos de caida antes del aviso de entrada (0 = al detectarla).
# PLAN_AUTONOMIA_FILE: CSV con autonomia/movilizacion por nodo (default datos/plan_autonomia.csv).
PLAN_ENTRADA_AFTER_MIN=0
# Heartbeat: avisa si el monitor lleva N min sin completar un ciclo (0 = desactivado).
HEARTBEAT_AFTER_MIN=30
HEARTBEAT_REPEAT_MIN=120
LOOP_INTERVAL_SEC=300
EXPORT_ONLY_IF_NEW=1
LOG_LEVEL=INFO
LOG_FILE=energia_loop.log

# WUG endpoints, comma-separated.
WUG_URLS=http://monitoreo.alliance.com.ni:8022/map.asp,http://whatsup.alliance.com.ni:8022/map.asp
